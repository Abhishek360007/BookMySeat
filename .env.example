# Copy to .env (never committed) and fill in real values. Used by: docker compose --profile app up
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-12-chars
# At least 32 bytes, e.g. from: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# Optional: Razorpay payments (test mode keys from the Razorpay dashboard: Settings > API Keys)
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-me
# Choose any secret, then enter the same value when creating the webhook in Razorpay
RAZORPAY_WEBHOOK_SECRET=replace-me
# Optional: emails. log = only logged; smtp = spring.mail.* (Mailpit locally); brevo = Brevo HTTP API
EMAIL_PROVIDER=log
# The sender address (with Brevo it must be a verified sender in your Brevo account)
EMAIL_FROM=no-reply@example.com
BREVO_API_KEY=replace-me
